{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Picker X",
  "version": "0.2.0",
  "identifier": "com.serverpickerx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Server Picker X",
        "width": 1160,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "backgroundColor": "#0e111b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
