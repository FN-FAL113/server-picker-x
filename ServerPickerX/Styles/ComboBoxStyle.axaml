<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="#09090B">
            <ComboBox Classes="game-combobox" Width="170" SelectedIndex="0">
                <ComboBoxItem>Counter Strike 2</ComboBoxItem>
                <ComboBoxItem>Deadlock</ComboBoxItem>
            </ComboBox>
        </Border>
    </Design.PreviewWith>

    <Style Selector="ComboBox.game-combobox">
        <Style.Resources>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A1A1AA" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource SpxControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SpxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource SpxTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource SpxTextFaintBrush}" />

        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SpxControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpxBorderBrush}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SpxControlPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpxRingBrush}" />
        </Style>

        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource SpxRingBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SpxControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SpxBorderMutedBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource SpxTextMutedBrush}" />
        </Style>
    </Style>

    <Style Selector="ComboBox.game-combobox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource SpxCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SpxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBox.game-combobox ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SpxTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>
