<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="0" Background="#1C1F22">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="titlebar-btn minimize-btn" Width="40" Height="32" />
                <Button Classes="titlebar-btn maximize-btn" Width="40" Height="32" />
                <Button Classes="titlebar-btn close-btn" Width="40" Height="32" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button.titlebar-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SpxTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SpxControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SpxTextBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SpxControlPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SpxTextBrush}" />
        </Style>
    </Style>

    <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SpxBadBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.close-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SpxBadBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
</Styles>
