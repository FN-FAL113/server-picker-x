<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d"
             x:CompileBindings="False"
             x:Class="ServerPickerX.FooterButtons">
    <StackPanel
        VerticalAlignment="Center"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Margin="0,0,10,0"
        Spacing="2">
        <Button x:Name="ThemeBtn"
                Classes="icon-btn"
                i:Attached.Icon="{Binding ThemeIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="ThemeBtn_Click" />
        <Button x:Name="PaypalBtn"
                Classes="icon-btn"
                i:Attached.Icon="fa-paypal"
                Click="PaypalBtn_Click" />
        <Button x:Name="GithubBtn"
                Classes="icon-btn"
                i:Attached.Icon="fa-github"
                Click="GithubBtn_Click" />
        <Button x:Name="SettingsBtn"
                Classes="icon-btn"
                i:Attached.Icon="fa-gear"
                Click="SettingsBtn_Click" />
    </StackPanel>
</UserControl>
