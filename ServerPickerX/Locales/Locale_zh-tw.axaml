<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="LanguageCode">zh-tw</x:String>
  <x:String x:Key="ClusterServers">群組伺服器</x:String>
  <x:String x:Key="UnclusterServers">取消群組</x:String>
  <x:String x:Key="Refresh">重新整理</x:String>
  <x:String x:Key="SearchForServers">搜尋伺服器...</x:String>
  <x:String x:Key="NoPresets">無預設集</x:String>
  <x:String x:Key="BlockAll">全部封鎖</x:String>
  <x:String x:Key="BlockSelected">封鎖所選伺服器</x:String>
  <x:String x:Key="UnblockAll">全部解除封鎖</x:String>
  <x:String x:Key="UnblockSelected">解除所選伺服器的封鎖</x:String>
  <x:String x:Key="SaveButtonText">儲存</x:String>
  <x:String x:Key="CancelButtonText">取消</x:String>
  <x:String x:Key="CheckForNewVersion">啟動時檢查新版本</x:String>
  <x:String x:Key="ResetFirewall">重設防火牆</x:String>
  <x:String x:Key="GameModeToolTip">選擇遊戲模式</x:String>
  <x:String x:Key="PresetToolTip">選擇預設集</x:String>
  <x:String x:Key="ClusterUnclusterToolTip">將伺服器分組或取消分組</x:String>
  <x:String x:Key="RefreshToolTip">重新整理所有伺服器的Ping</x:String>
  <x:String x:Key="SwapGameModeUnblockAllConflict">此操作會先解除所有伺服器的封鎖，以避免防火牆規則衝突。</x:String>
  <x:String x:Key="LanguageComboBoxToolTip">選擇語言</x:String>
  <x:String x:Key="ResetFirewallToolTip">重設防火牆規則</x:String>
  <x:String x:Key="MessageBoxInfoTitle">訊息</x:String>
  <x:String x:Key="SyncServersUnblockAllDialogue">Valve 剛更新了伺服器資料！為了同步新的伺服器資料，所有已封鎖的伺服器都會被解除封鎖。已不存在的伺服器，其預設集項目會被移除；若先前選取的預設集仍然可用，將會重新套用。</x:String>
  <x:String x:Key="NewVersionDialogue">有新版本可用！前往發行頁面？</x:String>
  <x:String x:Key="SelectOneServerToBlockDialogue">請至少選擇一台要封鎖的伺服器</x:String>
  <x:String x:Key="SelectOneServerToUnblockDialogue">請至少選擇一台要解除封鎖的伺服器</x:String>
  <x:String x:Key="PendingOperationDialogue">已經有一項操作正在進行中，請稍候……</x:String>
  <x:String x:Key="FirewallResetConfirmDialogue">這會將防火牆重設為預設狀態。確定要執行嗎？</x:String>
  <x:String x:Key="FirewallResetSuccessDialogue">防火牆已成功重設！</x:String>
  <x:String x:Key="Presets">預設集</x:String>
  <x:String x:Key="PresetsToolTip">管理預設集</x:String>
  <x:String x:Key="AddPreset">新增</x:String>
  <x:String x:Key="NewPresetName">新預設集</x:String>
  <x:String x:Key="AddPresetToolTip">建立新的預設集</x:String>
  <x:String x:Key="DeletePreset">刪除</x:String>
  <x:String x:Key="DeletePresetToolTip">刪除所選預設集</x:String>
  <x:String x:Key="ApplyPreset">套用</x:String>
  <x:String x:Key="ApplyPresetToolTip">套用所選預設集</x:String>
  <x:String x:Key="PresetsWindowTitle">預設集</x:String>
  <x:String x:Key="PresetServersHeader">已封鎖的伺服器</x:String>
  <x:String x:Key="BlockedColumnHeader">已封鎖</x:String>
  <x:String x:Key="PresetListHeader">預設集</x:String>
  <x:String x:Key="PresetDeleteConfirmDialogue">要刪除預設集「{0}」嗎？</x:String>
  <x:String x:Key="PresetDeleteSelectedConfirmDialogue">要刪除所選的 {0} 個預設集嗎？</x:String>
  <x:String x:Key="PresetOverwriteConfirmDialogue">此遊戲已有名為「{0}」的預設集。要覆蓋嗎？</x:String>
  <x:String x:Key="PresetChangeViewModeConfirmDialogue">在群組與非群組檢視之間切換，會清除此預設集中已封鎖的項目。要繼續嗎？</x:String>
  <x:String x:Key="PresetNameRequiredDialogue">預設集名稱不能空白。</x:String>
  <x:String x:Key="RenderMode">渲染模式：</x:String>
  <x:String x:Key="RenderModeToolTip">使用不同的圖形管線，變更應用程式在螢幕上的渲染方式。</x:String>
  <x:String x:Key="RenderModeDialogue">請重新啟動應用程式以套用變更。</x:String>
</ResourceDictionary>
